[Unit]
Description=Milk dashboard and API (behind CloudFront)
Wants=network-online.target
After=network-online.target

[Service]
User=milk
Group=milk
EnvironmentFile=/etc/milk/milk.env
WorkingDirectory=/opt/milk/app/server
# One worker only: live state is kept in memory.
ExecStart=/opt/milk/venv/bin/uvicorn milk.web.app:app --host 0.0.0.0 --port 80 --workers 1 --no-server-header
AmbientCapabilities=CAP_NET_BIND_SERVICE
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
