# systemd user unit for the counting worker on a GPU machine.
# Copy to ~/.config/systemd/user/milk-worker.service, edit the two paths, then:
#   systemctl --user daemon-reload && systemctl --user enable --now milk-worker
#   journalctl --user -u milk-worker -f
[Unit]
Description=Milk counting worker (reads the stream from the hub, counts on the GPU)
Wants=network-online.target
After=network-online.target

[Service]
# Folder of the cloned repository, and the Python of the environment that runs the model.
WorkingDirectory=%h/milk-camera/server
ExecStart=%h/milk-camera/.venv/bin/python -m milk.counter --env %h/milk-camera/worker.env
Restart=always
RestartSec=5
Nice=10
MemoryMax=12G

[Install]
WantedBy=default.target
